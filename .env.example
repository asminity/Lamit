# ============================================================
# LANGGRAPH WEB APPLICATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# --- Core Model & LLM Provider ---
OPENAI_API_KEY=your_openai_api_key_here
MODEL=gpt-5.4

# --- Database & Persistence ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=langgraph
POSTGRES_URI=postgresql://postgres:your_secure_postgres_password@localhost:5432/langgraph

# --- Security, Authentication, & CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_DEV_AUTH_BYPASS=false

# --- Google Cloud OAuth 2.0 Credentials ---
# Create Web Client in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Tools: Web Search ---
SERPAPI_API_KEY=your_serpapi_key_here

# --- Tools: Sensitive Actions (Gmail) ---
# Requires 16-character App Password from https://myaccount.google.com/apppasswords
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# --- Observability & Tracing (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=LangGraph-Chatbot

# --- Frontend Client Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Production Semantic Caching Layer ---
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.88
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_EMBEDDING_DIMENSION=1536
SEMANTIC_CACHE_MAX_ENTRIES_PER_USER=500
SEMANTIC_CACHE_CONFIG_VERSION=v1
# pgvector HNSW Configuration
SEMANTIC_CACHE_HNSW_M=16
SEMANTIC_CACHE_HNSW_EF_CONSTRUCTION=64
SEMANTIC_CACHE_HNSW_EF_SEARCH=40
SEMANTIC_CACHE_FORCE_ARRAY_FALLBACK=false
# --- Short-Term Memory (STM) & Rolling Summarization ---
SUMMARY_TRIGGER=12
STM_MAX_TOKENS=4000
STM_SUMMARY_TRIGGER_TOKENS=2500
STM_RECENT_MESSAGES_TOKEN_LIMIT=1200

# --- Long-Term Memory (LTM) & Retrieval Settings ---
LTM_ENABLED=true
LTM_SIMILARITY_THRESHOLD=0.70
LTM_TOP_K=6
LTM_IMPORTANCE_THRESHOLD=0.4
LTM_EXTRACTION_MODEL=gpt-4o-mini
